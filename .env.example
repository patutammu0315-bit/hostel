# ============================================================
# META WHATSAPP CLOUD API CONFIGURATION
# ============================================================
# Permanent System User Access Token from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=

# Meta WhatsApp Phone Number ID (From WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Custom secret string configured in Meta App Dashboard Webhook settings
WHATSAPP_VERIFY_TOKEN=IFET_WHATSAPP_VERIFY_2026

# Graph API Version (e.g., v20.0, v21.0)
WHATSAPP_API_VERSION=v21.0

# ============================================================
# SUPABASE POSTGRESQL CONFIGURATION
# ============================================================
# Supabase Project URL (e.g., https://yourproject.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (for browser/client if needed)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# AUTHORIZATION & TIMEZONE
# ============================================================
# Comma-separated list of authorized manager phone numbers (country code without '+')
# Example for India: 919876543210,919876543211
AUTHORIZED_WHATSAPP_NUMBERS=919876543210,919876543211

# Application Timezone (defaults to Asia/Kolkata for Indian Standard Time)
APP_TIMEZONE=Asia/Kolkata

# ============================================================
# ADMIN DASHBOARD AUTHENTICATION
# ============================================================
# Admin dashboard credentials (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HostelAdminPass2026!

# Secure random secret used to sign Admin session tokens (32+ random characters)
JWT_SECRET=super_secret_jwt_key_min_32_characters_random_string_2026
